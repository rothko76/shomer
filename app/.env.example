# Copy to .env for local dev. Never commit .env.
SHOMER_LLM_API_KEY=sk-or-...
SHOMER_LLM_MODEL=openai/gpt-oss-120b
# SHOMER_LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
# SHOMER_LLM_FALLBACK_MODEL=qwen3:8b
# Local dev: which kubeconfig context the agent reads
SHOMER_KUBE_CONTEXT=kind-shomer
SHOMER_LOG_JSON=false
SHOMER_PROMETHEUS_URL=http://localhost:9090
SHOMER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Shared secret Alertmanager sends as a bearer token (http_config.authorization)
SHOMER_WEBHOOK_TOKEN=change-me
